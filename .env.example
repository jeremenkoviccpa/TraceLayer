# App
APP_ENV=development
SECRET_KEY=changeme_generate_with_openssl_rand_hex_32

# Database
DATABASE_URL=postgresql+asyncpg://tracelayer:tracelayer@localhost:5432/tracelayer

# JWT
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Credential encryption — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=changeme_generate_fernet_key

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=["https://your-app.vercel.app","http://localhost:3000"]

# Frontend URL used in invite links
FRONTEND_URL=https://your-app.vercel.app

# Storage (Supabase)
STORAGE_BUCKET=reports
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Email (Resend) — leave blank to log emails to stdout in dev
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=TraceLayer <onboarding@resend.dev>

# Paddle billing
PADDLE_SK=your_paddle_secret_key
PADDLE_GROWTH_PRICE_ID=pri_your_price_id
PADDLE_WEBHOOK_SECRET=pdl_ntfset_your_secret
PADDLE_SANDBOX=false

# Internal accounts that bypass billing (comma-separated, e.g. "admin@example.com,dev@example.com")
INTERNAL_ADMINS=

# Observability
SENTRY_DSN=

# AI (Groq — for audit narrative generation)
GROQ_API_KEY=
