<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
      font-size: 11px;
      color: #1a1a2e;
      padding: 48px 56px;
      line-height: 1.6;
    }

    /* ── Cover ── */
    .cover {
      display: flex;
      flex-direction: column;
      height: 100vh;
      justify-content: center;
    }
    .cover-brand {
      font-size: 13px;
      font-weight: 700;
      color: #4f6ef7;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 48px;
    }
    .cover h1 {
      font-size: 32px;
      font-weight: 700;
      color: #1a1a2e;
      line-height: 1.2;
      margin-bottom: 12px;
    }
    .cover .subtitle {
      font-size: 16px;
      color: #6b7280;
      margin-bottom: 48px;
    }
    .cover-meta {
      display: flex;
      gap: 40px;
    }
    .cover-meta div { color: #6b7280; }
    .cover-meta strong { display: block; color: #1a1a2e; font-size: 13px; margin-top: 2px; }

    /* ── Section headings ── */
    h2 {
      font-size: 14px;
      font-weight: 700;
      color: #1a1a2e;
      margin-top: 40px;
      margin-bottom: 16px;
      padding-bottom: 8px;
      border-bottom: 2px solid #4f6ef7;
    }
    h3 {
      font-size: 12px;
      font-weight: 600;
      color: #374151;
      margin-top: 24px;
      margin-bottom: 8px;
    }

    /* ── Summary cards ── */
    .summary-grid {
      display: flex;
      gap: 16px;
      margin-bottom: 8px;
    }
    .summary-card {
      flex: 1;
      background: #f0f4ff;
      border-radius: 8px;
      padding: 16px 20px;
    }
    .summary-card .label { color: #6b7280; font-size: 10px; text-transform: uppercase; letter-spacing: 1px; }
    .summary-card .value { font-size: 28px; font-weight: 700; color: #1a1a2e; margin-top: 4px; }

    /* ── Score badge ── */
    .score-badge {
      display: inline-block;
      padding: 2px 10px;
      border-radius: 9999px;
      font-size: 10px;
      font-weight: 600;
    }
    .passing  { background: #d1fae5; color: #065f46; }
    .warning  { background: #fef3c7; color: #92400e; }
    .failing  { background: #fee2e2; color: #991b1b; }
    .no_evidence { background: #f3f4f6; color: #6b7280; }

    /* ── Control sections ── */
    .control-block {
      page-break-inside: avoid;
      margin-bottom: 32px;
    }
    .control-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: #f9fafb;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      padding: 12px 16px;
      margin-bottom: 8px;
    }
    .control-name { font-weight: 600; font-size: 12px; }
    .control-meta { color: #9ca3af; font-size: 10px; margin-top: 2px; }
    .control-score-num { font-size: 22px; font-weight: 700; color: #4f6ef7; }

    /* ── Evidence table ── */
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 8px;
    }
    thead tr { background: #f0f4ff; }
    th {
      text-align: left;
      padding: 8px 10px;
      font-size: 9px;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: #6b7280;
      font-weight: 600;
    }
    td {
      padding: 7px 10px;
      font-size: 10px;
      border-bottom: 1px solid #f3f4f6;
      color: #374151;
      word-break: break-all;
      max-width: 200px;
    }
    tr:last-child td { border-bottom: none; }
    tbody tr:hover { background: #fafafa; }

    /* ── Footer ── */
    .footer {
      position: fixed;
      bottom: 32px;
      left: 56px;
      right: 56px;
      border-top: 1px solid #e5e7eb;
      padding-top: 8px;
      display: flex;
      justify-content: space-between;
      color: #9ca3af;
      font-size: 9px;
    }

    /* ── Page break ── */
    .page-break { page-break-before: always; }
  </style>
</head>
<body>

  <!-- ── Cover page ── -->
  <div class="cover">
    <div class="cover-brand">TraceLayer</div>
    <h1>{{ framework | upper }} Compliance Report</h1>
    <p class="subtitle">Continuous Evidence Collection Report</p>
    <div class="cover-meta">
      <div>
        Organization
        <strong>{{ company_name }}</strong>
      </div>
      <div>
        Framework
        <strong>{{ framework | upper }}</strong>
      </div>
      <div>
        Report Type
        <strong>{{ report_type | title }}</strong>
      </div>
      <div>
        Generated
        <strong>{{ generated_at }}</strong>
      </div>
    </div>
  </div>

  <!-- ── Executive Summary ── -->
  <div class="page-break"></div>

  <h2>Executive Summary</h2>

  <div class="summary-grid">
    <div class="summary-card">
      <div class="label">Total evidence records</div>
      <div class="value">{{ total_records }}</div>
    </div>
    <div class="summary-card">
      <div class="label">Controls monitored</div>
      <div class="value">{{ controls | length }}</div>
    </div>
    <div class="summary-card">
      <div class="label">Overall score</div>
      <div class="value">{{ overall_score }}%</div>
    </div>
  </div>

  <!-- ── Control Sections ── -->
  {% for control_category, records in controls.items() %}
  <div class="control-block">
    <h2>{{ control_category | replace('_', ' ') | title }}</h2>

    <div class="control-header">
      <div>
        <div class="control-name">{{ control_category | replace('_', ' ') | title }}</div>
        <div class="control-meta">{{ records | length }} evidence records collected</div>
      </div>
    </div>

    {% if records %}
    <table>
      <thead>
        <tr>
          <th>Integration</th>
          <th>Evidence Type</th>
          <th>Source ID</th>
          <th>Timestamp</th>
        </tr>
      </thead>
      <tbody>
        {% for rec in records %}
        <tr>
          <td>{{ rec.integration }}</td>
          <td>{{ rec.evidence_type }}</td>
          <td>{{ rec.source_id }}</td>
          <td>{{ rec.timestamp }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    <p style="color: #9ca3af; font-style: italic; padding: 12px 0;">No evidence collected for this control.</p>
    {% endif %}
  </div>
  {% endfor %}

  <!-- ── Footer ── -->
  <div class="footer">
    <span>TraceLayer · Continuous Compliance Evidence Collection</span>
    <span>Report ID: {{ report_id }}</span>
  </div>

</body>
</html>
