<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <style>
    /* ── Reset & base ── */
    * { box-sizing: border-box; margin: 0; padding: 0; }

    @page {
      size: A4;
      margin: 0;
      @bottom-center {
        content: counter(page) " / " counter(pages);
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
        font-size: 9px;
        color: #9ca3af;
      }
    }

    body {
      font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
      font-size: 10.5px;
      color: #111827;
      line-height: 1.55;
      counter-reset: page;
    }

    /* ── Page layout ── */
    .page {
      width: 210mm;
      min-height: 297mm;
      padding: 52px 56px 72px 56px;
      page-break-after: always;
      position: relative;
    }
    .page:last-child { page-break-after: auto; }

    /* ── Accent bar (left edge on content pages) ── */
    .accent-bar {
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 5px;
      background: #4f46e5;
    }

    /* ══════════════════════════════════════════
       COVER PAGE
    ══════════════════════════════════════════ */
    .cover {
      padding: 0;
      display: flex;
      flex-direction: column;
    }
    .cover-top {
      background: #4f46e5;
      height: 220px;
      padding: 52px 56px;
      display: flex;
      align-items: flex-end;
    }
    .cover-brand {
      font-size: 22px;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: -0.5px;
    }
    .cover-body {
      padding: 48px 56px;
      flex: 1;
    }
    .cover-eyebrow {
      font-size: 11px;
      font-weight: 600;
      color: #4f46e5;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 16px;
    }
    .cover h1 {
      font-size: 34px;
      font-weight: 800;
      color: #111827;
      line-height: 1.15;
      margin-bottom: 8px;
      letter-spacing: -0.5px;
    }
    .cover .cover-subtitle {
      font-size: 14px;
      color: #6b7280;
      margin-bottom: 48px;
    }
    .cover-divider {
      border: none;
      border-top: 1px solid #e5e7eb;
      margin-bottom: 32px;
    }
    .cover-meta-grid {
      display: flex;
      gap: 0;
    }
    .cover-meta-item {
      flex: 1;
      border-right: 1px solid #e5e7eb;
      padding-right: 24px;
      margin-right: 24px;
    }
    .cover-meta-item:last-child {
      border-right: none;
      padding-right: 0;
      margin-right: 0;
    }
    .cover-meta-label {
      font-size: 9px;
      font-weight: 600;
      color: #9ca3af;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 4px;
    }
    .cover-meta-value {
      font-size: 13px;
      font-weight: 700;
      color: #111827;
    }
    .cover-footer {
      padding: 24px 56px;
      border-top: 1px solid #e5e7eb;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .cover-footer-left { font-size: 9px; color: #9ca3af; }
    .cover-footer-badge {
      background: #f0f0fe;
      color: #4f46e5;
      font-size: 9px;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 99px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    /* ══════════════════════════════════════════
       SECTION HEADINGS
    ══════════════════════════════════════════ */
    .section-label {
      font-size: 9px;
      font-weight: 700;
      color: #4f46e5;
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 6px;
    }
    h2 {
      font-size: 18px;
      font-weight: 800;
      color: #111827;
      margin-bottom: 24px;
      letter-spacing: -0.3px;
    }
    h3 {
      font-size: 12px;
      font-weight: 700;
      color: #111827;
      margin-top: 28px;
      margin-bottom: 10px;
    }

    /* ══════════════════════════════════════════
       SCORE RING (CSS-only)
    ══════════════════════════════════════════ */
    .score-section {
      display: flex;
      align-items: center;
      gap: 40px;
      margin-bottom: 32px;
    }
    .score-ring-wrap {
      flex-shrink: 0;
    }
    .score-ring {
      width: 100px;
      height: 100px;
      border-radius: 50%;
      background: #f0f4ff;
      border: 6px solid {{ score_color }};
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .score-ring-inner {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    .score-number {
      font-size: 22px;
      font-weight: 800;
      color: #111827;
      line-height: 1;
    }
    .score-pct {
      font-size: 10px;
      color: #6b7280;
      font-weight: 600;
    }
    .score-legend {
      flex: 1;
    }
    .score-legend-title {
      font-size: 13px;
      font-weight: 700;
      color: #111827;
      margin-bottom: 4px;
    }
    .score-legend-sub {
      font-size: 10.5px;
      color: #6b7280;
      margin-bottom: 16px;
    }
    .score-stats {
      display: flex;
      gap: 24px;
    }
    .score-stat {
      text-align: center;
    }
    .score-stat-value {
      font-size: 22px;
      font-weight: 800;
      color: #111827;
    }
    .score-stat-label {
      font-size: 9px;
      color: #9ca3af;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin-top: 2px;
    }

    /* ══════════════════════════════════════════
       STATUS BADGES
    ══════════════════════════════════════════ */
    .badge {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 99px;
      font-size: 9px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .badge-passing  { background: #d1fae5; color: #065f46; }
    .badge-warning  { background: #fef3c7; color: #92400e; }
    .badge-failing  { background: #fee2e2; color: #991b1b; }
    .badge-no_evidence { background: #f3f4f6; color: #6b7280; }

    /* ══════════════════════════════════════════
       CONTROL SUMMARY TABLE (exec summary)
    ══════════════════════════════════════════ */
    .summary-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 8px;
    }
    .summary-table thead tr {
      background: #f5f3ff;
    }
    .summary-table th {
      text-align: left;
      padding: 9px 12px;
      font-size: 9px;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: #4f46e5;
      font-weight: 700;
      border-bottom: 2px solid #4f46e5;
    }
    .summary-table td {
      padding: 9px 12px;
      font-size: 10px;
      border-bottom: 1px solid #f3f4f6;
      color: #374151;
      vertical-align: middle;
    }
    .summary-table tbody tr:nth-child(even) td {
      background: #fafafa;
    }
    .score-bar-wrap {
      width: 80px;
      height: 6px;
      background: #f3f4f6;
      border-radius: 99px;
      overflow: hidden;
      display: inline-block;
      vertical-align: middle;
      margin-right: 6px;
    }
    .score-bar-fill {
      height: 100%;
      border-radius: 99px;
    }
    .fill-green  { background: #10b981; }
    .fill-yellow { background: #f59e0b; }
    .fill-red    { background: #ef4444; }

    /* ══════════════════════════════════════════
       CONTROL DETAIL SECTIONS
    ══════════════════════════════════════════ */
    .control-block {
      page-break-inside: avoid;
      margin-bottom: 36px;
    }
    .control-header {
      background: #f9fafb;
      border: 1px solid #e5e7eb;
      border-left: 4px solid #4f46e5;
      border-radius: 0 8px 8px 0;
      padding: 14px 18px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 10px;
    }
    .control-header-left { }
    .control-name {
      font-weight: 700;
      font-size: 12px;
      color: #111827;
      margin-bottom: 3px;
    }
    .control-meta { color: #9ca3af; font-size: 9.5px; }
    .control-header-right {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .control-score-num {
      font-size: 24px;
      font-weight: 800;
      color: #4f46e5;
    }
    .missing-types {
      font-size: 9.5px;
      color: #ef4444;
      margin-top: 4px;
    }
    .missing-types span { font-weight: 600; }

    /* ══════════════════════════════════════════
       EVIDENCE TABLE
    ══════════════════════════════════════════ */
    .evidence-table {
      width: 100%;
      border-collapse: collapse;
    }
    .evidence-table thead tr { background: #f5f3ff; }
    .evidence-table th {
      text-align: left;
      padding: 7px 10px;
      font-size: 8.5px;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: #6b7280;
      font-weight: 700;
    }
    .evidence-table td {
      padding: 7px 10px;
      font-size: 9.5px;
      border-bottom: 1px solid #f3f4f6;
      color: #374151;
      word-break: break-word;
      max-width: 160px;
    }
    .evidence-table tbody tr:last-child td { border-bottom: none; }
    .evidence-table tbody tr:nth-child(even) td { background: #fafafa; }
    .tag {
      display: inline-block;
      background: #ede9fe;
      color: #5b21b6;
      border-radius: 4px;
      padding: 1px 6px;
      font-size: 8.5px;
      font-weight: 600;
    }
    .no-evidence {
      color: #9ca3af;
      font-style: italic;
      padding: 12px 0;
      font-size: 10px;
    }

    /* ══════════════════════════════════════════
       FOOTER
    ══════════════════════════════════════════ */
    .page-footer {
      position: fixed;
      bottom: 24px;
      left: 56px;
      right: 56px;
      border-top: 1px solid #e5e7eb;
      padding-top: 8px;
      display: flex;
      justify-content: space-between;
      color: #9ca3af;
      font-size: 8.5px;
    }

    .page-break { page-break-before: always; }
  </style>
</head>
<body>

<!-- ════════════════════════════════════════
     COVER PAGE
════════════════════════════════════════ -->
<div class="page cover">
  <div class="cover-top">
    <div class="cover-brand">TraceLayer</div>
  </div>

  <div class="cover-body">
    <div class="cover-eyebrow">Compliance Evidence Report</div>
    <h1>
      {% if framework == "soc2" %}SOC 2
      {% elif framework == "iso27001" %}ISO 27001
      {% elif framework == "hipaa" %}HIPAA
      {% else %}{{ framework | upper }}
      {% endif %}
      Audit Report
    </h1>
    <p class="cover-subtitle">{{ report_type | title }} — Continuous Evidence Collection</p>

    <hr class="cover-divider">

    <div class="cover-meta-grid">
      <div class="cover-meta-item">
        <div class="cover-meta-label">Organization</div>
        <div class="cover-meta-value">{{ company_name }}</div>
      </div>
      <div class="cover-meta-item">
        <div class="cover-meta-label">Framework</div>
        <div class="cover-meta-value">
          {% if framework == "soc2" %}SOC 2 Type II
          {% elif framework == "iso27001" %}ISO/IEC 27001
          {% elif framework == "hipaa" %}HIPAA
          {% else %}{{ framework | upper }}
          {% endif %}
        </div>
      </div>
      <div class="cover-meta-item">
        <div class="cover-meta-label">Date Generated</div>
        <div class="cover-meta-value">{{ generated_at }}</div>
      </div>
      <div class="cover-meta-item">
        <div class="cover-meta-label">Compliance Score</div>
        <div class="cover-meta-value" style="color: {{ score_color }};">{{ overall_score }}%</div>
      </div>
    </div>
  </div>

  <div class="cover-footer">
    <div class="cover-footer-left">
      Report ID: {{ report_id }}<br>
      Generated: {{ generated_at_full }}
    </div>
    <div class="cover-footer-badge">Confidential</div>
  </div>
</div>

<!-- ════════════════════════════════════════
     EXECUTIVE SUMMARY
════════════════════════════════════════ -->
<div class="page">
  <div class="accent-bar"></div>

  <div class="section-label">Section 1</div>
  <h2>Executive Summary</h2>

  <!-- Score ring + stats -->
  <div class="score-section">
    <div class="score-ring-wrap">
      <div class="score-ring">
        <div class="score-ring-inner">
          <div class="score-number">{{ overall_score }}</div>
          <div class="score-pct">/ 100</div>
        </div>
      </div>
    </div>
    <div class="score-legend">
      <div class="score-legend-title">Overall Compliance Score</div>
      <div class="score-legend-sub">
        Based on evidence coverage, recency, and volume across all monitored controls.
      </div>
      <div class="score-stats">
        <div class="score-stat">
          <div class="score-stat-value">{{ total_records }}</div>
          <div class="score-stat-label">Evidence records</div>
        </div>
        <div class="score-stat">
          <div class="score-stat-value">{{ control_scores | length }}</div>
          <div class="score-stat-label">Controls monitored</div>
        </div>
        <div class="score-stat">
          <div class="score-stat-value">{{ control_scores | selectattr('status', 'eq', 'passing') | list | length }}</div>
          <div class="score-stat-label">Passing</div>
        </div>
        <div class="score-stat">
          <div class="score-stat-value" style="color:#ef4444;">
            {{ (control_scores | selectattr('status', 'eq', 'failing') | list | length) + (control_scores | selectattr('status', 'eq', 'no_evidence') | list | length) }}
          </div>
          <div class="score-stat-label">Needs action</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Control breakdown table -->
  <h3>Control Breakdown</h3>
  <table class="summary-table">
    <thead>
      <tr>
        <th>Control</th>
        <th>Status</th>
        <th>Score</th>
        <th>Evidence</th>
        <th>Missing evidence types</th>
      </tr>
    </thead>
    <tbody>
      {% for c in control_scores %}
      <tr>
        <td style="font-weight:600;">{{ c.name }}</td>
        <td><span class="badge badge-{{ c.status }}">{{ c.status | replace('_', ' ') }}</span></td>
        <td>
          <div style="display:flex; align-items:center;">
            <div class="score-bar-wrap">
              <div class="score-bar-fill {% if c.score >= 80 %}fill-green{% elif c.score >= 50 %}fill-yellow{% else %}fill-red{% endif %}"
                   style="width:{{ c.score }}%;"></div>
            </div>
            <span style="font-weight:700;">{{ c.score }}%</span>
          </div>
        </td>
        <td>{{ c.evidence_count }}</td>
        <td style="color:#9ca3af;">
          {% if c.missing_types %}
            {{ c.missing_types | join(', ') }}
          {% else %}
            <span style="color:#065f46;">All covered</span>
          {% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="page-footer">
    <span>TraceLayer · {{ company_name }} · {{ framework | upper }} Report</span>
    <span>Confidential — {{ generated_at }}</span>
  </div>
</div>

<!-- ════════════════════════════════════════
     CONTROL DETAIL SECTIONS
════════════════════════════════════════ -->
{% set ns = namespace(section_num = 2) %}
{% for c in control_scores %}
{% set ns.section_num = ns.section_num + 1 %}
{% set evidence_list = controls.get(c.category, []) %}

<div class="page">
  <div class="accent-bar"></div>

  <div class="section-label">Section {{ ns.section_num }}</div>
  <h2>{{ c.name }}</h2>

  <!-- Control header card -->
  <div class="control-header">
    <div class="control-header-left">
      <div class="control-name">{{ c.name }}</div>
      <div class="control-meta">
        Category: {{ c.category | replace('_', ' ') | title }} &nbsp;·&nbsp;
        {{ c.evidence_count }} evidence record{% if c.evidence_count != 1 %}s{% endif %} &nbsp;·&nbsp;
        Last collected: {{ c.last_collected[:10] if c.last_collected else 'Never' }}
      </div>
      {% if c.missing_types %}
      <div class="missing-types">Missing: <span>{{ c.missing_types | join(', ') }}</span></div>
      {% endif %}
    </div>
    <div class="control-header-right">
      <div>
        <span class="badge badge-{{ c.status }}">{{ c.status | replace('_', ' ') }}</span>
      </div>
      <div class="control-score-num">{{ c.score }}%</div>
    </div>
  </div>

  <!-- Evidence table -->
  {% if evidence_list %}
  <table class="evidence-table">
    <thead>
      <tr>
        <th>Integration</th>
        <th>Evidence type</th>
        <th>Source ID</th>
        <th>Collected at</th>
      </tr>
    </thead>
    <tbody>
      {% for rec in evidence_list %}
      <tr>
        <td><span class="tag">{{ rec.integration }}</span></td>
        <td>{{ rec.evidence_type }}</td>
        <td style="font-family: monospace; font-size:9px; color:#6b7280;">{{ rec.source_id[:48] }}{% if rec.source_id | length > 48 %}…{% endif %}</td>
        <td>{{ rec.timestamp[:19] | replace('T', ' ') }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p class="no-evidence">No evidence collected for this control. Connect an integration that provides: {{ c.missing_types | join(', ') if c.missing_types else 'relevant data sources' }}.</p>
  {% endif %}

  <div class="page-footer">
    <span>TraceLayer · {{ company_name }} · {{ framework | upper }} Report</span>
    <span>Confidential — {{ generated_at }}</span>
  </div>
</div>
{% endfor %}

</body>
</html>
